# Claude API (анализ трендов и сценарии)
ANTHROPIC_API_KEY=

# TikTok for Developers: приложение с продуктами Login Kit + Content Posting API (+ Display API для статистики)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://localhost/callback
# Заполняется командой `trendbot auth-exchange`, хранится в data/tiktok_token.json

# Опционально: TikTok Research API (нужна одобренная заявка)
TIKTOK_RESEARCH_CLIENT_KEY=
TIKTOK_RESEARCH_CLIENT_SECRET=
